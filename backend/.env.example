NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://krystal:krystal_dev_password@localhost:5432/krystals_flower_kreations?schema=public"
# Session-pooler connection used by `prisma db push` (no pgbouncer). Same as DATABASE_URL locally.
DIRECT_URL="postgresql://krystal:krystal_dev_password@localhost:5432/krystals_flower_kreations?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=24h
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# PayPal (Orders v2). PAYPAL_MODE: off | mock | sandbox | live (default: off
# outside tests, mock when NODE_ENV=test). Client ID also lives in the public
# `paypal_client_id` setting (Admin → Settings → Payments) — env wins if set.
PAYPAL_MODE=off
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
MOBILE_URL=exp://192.168.1.10:19000
# Image storage — optional locally (falls back to backend/uploads). Prod uses Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
META_APP_ID=
META_APP_SECRET=
META_CATALOG_ID=
META_PAGE_ID=
META_ACCESS_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TAX_GST_RATE=0.10
ABN=
BUSINESS_NAME="Krystal's Flower Kreations"
BUSINESS_ADDRESS="Perth WA 6000"

# ── LLM (optional) — procedure analysis + document enrichment ───────────────
# LLM_PROVIDER: anthropic | openai | opencode-go | gemini (default: anthropic)
LLM_PROVIDER=
LLM_API_KEY=
# Gemini provider reads GEMINI_API_KEY (Google AI Studio key) when set.
GEMINI_API_KEY=
# Optional model override (defaults per provider, e.g. gemini-3.1-flash-lite)
LLM_MODEL=
