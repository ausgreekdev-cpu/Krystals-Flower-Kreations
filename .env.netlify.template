# Netlify Environment Variables — Krystal's Flower Kreations
# Dashboard → Site Settings → Environment Variables  (or netlify env:set)

# ── Database (Required) — Supabase/Neon Postgres in ap-southeast-2 (Sydney) ──
# Create Supabase project (Sydney) → Settings → Database → Connection string (pooled 6543)
# Must include ?pgbouncer=true&connection_limit=1 for serverless Functions
DATABASE_URL=postgresql://postgres.[project]:[password]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct (session pooler, :5432) connection — used by prisma db push / migrations.
# IMPORTANT: must NOT include pgbouncer=true (transaction pooler can't run DDL).
DIRECT_URL=postgresql://postgres.[project]:[password]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# ── Object storage (Required for product images on Netlify) ──
# Netlify function filesystems are read-only/ephemeral — uploaded images MUST go
# to Supabase Storage. Settings → API → Project URL + service_role key.
# Never expose the service_role key to the frontend.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[service_role_key]
SUPABASE_STORAGE_BUCKET=product-images

# ── Auth ──
JWT_SECRET=openssl rand -base64 48  # generate: openssl rand -base64 48
JWT_EXPIRES_IN=7d

# ── Runtime ──
NODE_ENV=production
# PORT=3001  (Netlify functions inject their own port — leave unset)

# ── App URLs ──
FRONTEND_URL=https://krystalsflowerkreations.netlify.app
# FRONTEND_URL is used for CORS and Meta catalog product URLs

# ── Payments — disabled for now (cash/bank/pickup) ──
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# To re-enable: STRIPE_ENABLED=true + STRIPE_SECRET_KEY=sk_live_... + add Stripe webhook at https://…/.netlify/functions/api/api/webhooks/stripe

# ── Email (order confirmations, workshop reminders, low-stock alerts) ──
# Set SMTP_* to enable sending; without them the app silently skips emails.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=noreply@krystalsflowerkreations.com.au
SMTP_PASS=...
SMTP_SECURE=false
EMAIL_FROM=Krystal's Flower Kreations <noreply@krystalsflowerkreations.com.au>

# ── Meta Facebook + Instagram Shop (optional) ──
META_APP_ID=
META_APP_SECRET=
META_CATALOG_ID=
META_PAGE_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=krystal_verify

# ── Rate-limit store (optional; unset = auto: DB in prod, memory in dev) ──
# RATE_LIMIT_STORE=db

# ── Branding / ABN ──
COMPANY_NAME=Krystal's Flower Kreations
COMPANY_ADDRESS=Perth WA 6000
COMPANY_PHONE=+61
COMPANY_EMAIL=krystal@krystalsflowerkreations.com.au
BUSINESS_ADDRESS=Perth WA 6000
ABN=XX XXX XXX XXX
TAX_GST_RATE=0.10
POWERED_BY=Krystal's Flower Kreations — Perth WA

# ── Build ──
NODE_VERSION=22
NPM_CONFIG_CACHE=/opt/buildhome/.npm

# ── Bootstrap admin (Netlify first deploy) ──
# If using empty DB, create first admin without seed:
NETLIFY_ADMIN_EMAIL=krystal@krystalsflowerkreations.com.au
NETLIFY_ADMIN_PASSWORD=change-me-on-first-login
# (Seed script will hash before storing; remove after first deploy)

# ── Optional ──
# MAPBOX_TOKEN=
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
