{
  "expo": {
    "name": "Krystal's Flower Kreations",
    "slug": "krystals-flower-kreations",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "krystal",
    "userInterfaceStyle": "light",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#FFF7F0" },
    "assetBundlePatterns": ["**/*"],
    "description": "Perth WA paper florist & armature art — Cricut + origami everlasting bouquets, custom configurator, workshops & studio POS. Handmade in Perth.",
    "primaryColor": "#B85C5C",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krystalsflowerkreations.shop",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Krystal's Flower Kreations to access your photos to share your blooms and upload workshop photos.",
        "NSCameraUsageDescription": "Allow camera to scan QR tickets, capture bouquet photos and for product sharing.",
        "NSUserTrackingUsageDescription": "Used to measure workshop and product interest to improve Perth studio offerings."
      }
    },
    "android": {
      "package": "com.krystalsflowerkreations.shop",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF7F0",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFF7F0",
        "dark": { "backgroundColor": "#2B1A1A" }
      }
    },
    "web": { "bundler": "metro", "output": "static", "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {}
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Krystal's Flower Kreations to access your photos for sharing blooms."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access camera to scan QR workshop tickets and capture bloom photos."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": false
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "eas": { "projectId": "krystals-flower-kreations-placeholder" }
    },
    "owner": "krystals-flower-kreations",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "url": "https://u.expo.dev/krystals-flower-kreations-placeholder" }
  }
}
