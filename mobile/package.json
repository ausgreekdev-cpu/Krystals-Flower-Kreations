{
  "name": "krystal-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "android:apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleDebug",
    "android:bundle": "expo prebuild --platform android --clean && cd android && ./gradlew bundleRelease",
    "prebuild": "expo prebuild --clean",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "expo": "~52.0.11",
    "expo-build-properties": "^0.13.3",
    "expo-camera": "~16.0.18",
    "expo-image-picker": "~16.0.3",
    "expo-router": "~4.0.15",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "nativewind": "^2.0.11",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "^0.19.13",
    "tailwindcss": "3.4.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "typescript": "^5.3.3"
  }
}
