{
  "name": "krystals-flower-kreations",
  "private": true,
  "version": "0.1.0",
  "description": "Krystal's Flower Kreations \u2014 paper florist & sculptural art workshop (Perth WA). Cricut + origami shop, blog, POS & workshop platform.",
  "workspaces": [
    "backend",
    "frontend",
    "mobile"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install",
    "db:up": "docker compose up -d db",
    "db:push": "cd backend && npx prisma db push",
    "db:seed": "npm run seed --workspace=backend",
    "lint": "cd backend && npm run lint; cd ../frontend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "turndown": "^7.2.4"
  },
  "overrides": {
    "express": {
      "qs": "6.16.1"
    },
    "body-parser": {
      "qs": "6.16.1"
    },
    "metro": {
      "image-size": "2.0.4"
    },
    "@expo/cli": {
      "tar": "7.5.22"
    },
    "cacache": {
      "tar": "7.5.22"
    },
    "@expo/plist": {
      "@xmldom/xmldom": "0.9.12"
    },
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    },
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "@rollup/plugin-terser": {
      "serialize-javascript": "7.1.4"
    },
    "@expo/metro-config": {
      "postcss": "8.5.31"
    }
  }
}
